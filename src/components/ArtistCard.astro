---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ContactLink from './ContactLink.astro';

interface Props {
  artist: CollectionEntry<'artists'>;
  /**
   * 'lead' is the featured plate at the top of the roster: wider, larger, and
   * showing its metadata without waiting for a hover, because presenting that
   * artist is the whole point of the slot.
   */
  variant?: 'grid' | 'lead';
  /** Above-the-fold cards should not lazy-load. */
  eager?: boolean;
  /**
   * Whether this card reveals itself on scroll. The featured carousel opts
   * out: its slides are stacked, so the container reveals once instead of
   * every slide fighting over the same space.
   */
  reveal?: boolean;
}

const { artist, variant = 'grid', eager = false, reveal = true } = Astro.props;
const { name, tagline, genres, heroImage, manager, bookingTerritories, status } = artist.data;
const isLead = variant === 'lead';

const widths = isLead ? [640, 960, 1400, 1900] : [400, 600, 800, 1200];
const sizes = isLead
  ? '(min-width: 1200px) 76rem, 94vw'
  : '(min-width: 1100px) 32vw, (min-width: 700px) 46vw, 92vw';
---

<article class:list={['card', isLead && 'card--lead']} data-reveal={reveal ? '' : undefined}>
  <div class="card__media">
    <Picture
      src={heroImage.src}
      alt={heroImage.alt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />

    <h3 class="card__name">
      <a class="card__link" href={`/artists/${artist.id}/`}>{name}</a>
    </h3>

    <div class="card__reveal">
      <p class="card__tagline">{tagline}</p>
      <p class="card__genres">{genres.join(' · ')}</p>
      {
        isLead && bookingTerritories && (
          <p class="card__territories">
            <span class="card__meta-role">Booking</span> {bookingTerritories}
          </p>
        )
      }
      <div class="card__meta">
        {
          manager && (
            <p class="card__manager">
              <span class="card__meta-role">Manager</span>{' '}
              <ContactLink contact={manager} />
            </p>
          )
        }
        <p class="card__credit">Photo: {heroImage.credit}</p>
      </div>
    </div>

    {status === 'associate' && <p class="card__status label">Associate</p>}
  </div>
</article>

<style>
  .card {
    margin: 0;
  }

  /*
   * Grid overlay rather than absolute positioning: every child occupies the
   * same cell, which keeps .card__name unpositioned so the stretched link
   * below resolves against .card__media and covers the whole image.
   */
  .card__media {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    isolation: isolate;
  }

  .card--lead .card__media {
    aspect-ratio: 16 / 10;
  }

  @media (max-width: 40rem) {
    .card--lead .card__media {
      aspect-ratio: 4 / 5;
    }
  }

  /*
   * `aspect-ratio` fixes the container's height but does NOT constrain the
   * grid row: the row was auto-sizing to the photograph's natural aspect, so
   * every overlay stretched past the visible box and `overflow: hidden` cut
   * the manager and credit line off the bottom. minmax(0, 1fr) pins the row
   * to the container instead.
   */
  .card__media {
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: minmax(0, 1fr);
  }

  .card__media > * {
    grid-area: 1 / 1;
  }

  /* Top scrim for the name. Fades out downward so it never cuts a hard
     edge across the photograph. Pseudo-elements of a grid container are
     grid items, but `> *` does not match them, so it is placed explicitly. */
  .card__media::before {
    content: '';
    grid-area: 1 / 1;
    align-self: start;
    block-size: 42%;
    z-index: 1;
    background: var(--scrim-top);
    pointer-events: none;
  }

  .card__media :global(picture),
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration) var(--ease);
  }

  .card__name {
    align-self: start;
    justify-self: start;
    z-index: 2;
    margin: var(--space-sm) var(--space-md);
    color: var(--on-scrim);
    font-size: var(--text-lg);
    font-weight: 600;
    font-stretch: var(--width-display);
    letter-spacing: var(--tracking-tight);
  }

  .card--lead .card__name {
    margin: var(--space-md) var(--space-lg);
    font-size: var(--text-2xl);
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link: the whole image is clickable, but only this one <a>
     exists for it, so the link text stays the artist's name. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card__status {
    align-self: start;
    justify-self: end;
    z-index: 2;
    margin: var(--space-sm) var(--space-md);
    color: var(--on-scrim-muted);
  }

  /*
   * The information box. It stretches over the whole image rather than taking
   * a percentage height: a percentage resolved against an aspect-ratio track
   * overflowed the media and `overflow: hidden` silently clipped the manager
   * and credit line off the lead plate. The gradient is transparent across the
   * top third, so a full-height box still reads as a band at the bottom.
   */
  .card__reveal {
    align-self: stretch;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2xs);
    padding: var(--space-md);
    background: var(--scrim-bottom);
    color: var(--on-scrim);
    /* Let clicks through to the stretched link, except on real links. */
    pointer-events: none;
  }

  .card--lead .card__reveal {
    padding: var(--space-lg);
  }

  .card__reveal :global(a) {
    pointer-events: auto;
    position: relative;
    z-index: 3;
  }

  .card__tagline {
    margin: 0;
    max-width: 40ch;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .card--lead .card__tagline {
    max-width: 44ch;
    font-size: var(--text-lg);
  }

  .card__genres {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 500;
    font-stretch: var(--width-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--on-scrim-muted);
  }

  .card__territories {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--on-scrim-muted);
  }

  /* Manager on the left, photographer credit pinned to the bottom-right. */
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-sm);
    margin-block-start: var(--space-2xs);
  }

  .card__manager {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--on-scrim-muted);
  }

  .card__meta-role {
    font-stretch: var(--width-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .card__credit {
    /* auto margin keeps it right-aligned even when there is no manager */
    margin: 0 0 0 auto;
    text-align: end;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--on-scrim-muted);
  }

  /*
   * Hover is an enhancement, never the only route to the information.
   * Where there is no fine pointer — touch, most tablets — the box is simply
   * visible, so tapping is never required to read it.
   */
  @media (hover: hover) and (pointer: fine) {
    .card__reveal {
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity var(--duration) var(--ease),
        transform var(--duration) var(--ease);
    }

    .card:hover .card__reveal,
    .card:focus-within .card__reveal {
      opacity: 1;
      transform: none;
    }

    /* The lead plate is the feature: it states itself without being asked. */
    .card--lead .card__reveal {
      opacity: 1;
      transform: none;
    }

    .card:hover .card__media :global(img),
    .card:focus-within .card__media :global(img) {
      transform: scale(1.03);
    }
  }

  /*
   * A slow drift on the lead photograph, driven by the scroll position rather
   * than by JS. Deliberately small — a couple of percent — so it reads as the
   * plate settling rather than as a parallax effect. Browsers without
   * scroll-driven animations simply get a still image.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .card--lead .card__media :global(img) {
        animation: lead-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes lead-drift {
    from {
      transform: scale(1.06) translateY(-2%);
    }
    to {
      transform: scale(1.06) translateY(2%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__reveal {
      opacity: 1 !important;
      transform: none !important;
    }

    .card__media :global(img) {
      transform: none !important;
      animation: none !important;
    }
  }
</style>
