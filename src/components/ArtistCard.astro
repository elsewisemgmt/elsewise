---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ContactLink from './ContactLink.astro';

interface Props {
  artist: CollectionEntry<'artists'>;
  /** The first few cards are above the fold and should not lazy-load. */
  eager?: boolean;
}

const { artist, eager = false } = Astro.props;
const { name, tagline, genres, heroImage, manager } = artist.data;
---

<article class="card" data-reveal>
  <div class="card__media">
    <Picture
      src={heroImage.src}
      alt={heroImage.alt}
      formats={['avif', 'webp']}
      widths={[400, 600, 800, 1200]}
      sizes="(min-width: 1100px) 32vw, (min-width: 700px) 46vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />

    <h2 class="card__name">
      <a class="card__link" href={`/artists/${artist.id}/`}>{name}</a>
    </h2>

    <div class="card__reveal">
      <p class="card__tagline">{tagline}</p>
      <p class="card__genres">{genres.join(' · ')}</p>
      {
        manager && (
          <p class="card__manager">
            <span class="card__manager-role">Manager</span>{' '}
            <ContactLink contact={manager} />
          </p>
        )
      }
    </div>
  </div>

  <p class="credit">Photo: {heroImage.credit}</p>
</article>

<style>
  .card {
    margin: 0;
  }

  /*
   * Grid overlay rather than absolute positioning: every child occupies the
   * same cell, which keeps .card__name unpositioned so the stretched link
   * below resolves against .card__media and covers the whole image.
   */
  .card__media {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    isolation: isolate;
  }

  .card__media > * {
    grid-area: 1 / 1;
  }

  .card__media :global(picture),
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration) var(--ease);
  }

  /* Name sits on the image at all times, on its own scrim for legibility. */
  .card__name {
    align-self: start;
    justify-self: start;
    z-index: 2;
    margin: var(--space-sm);
    padding: 0.3em 0.55em;
    background: var(--scrim);
    color: var(--on-scrim);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link: the whole image is clickable, but only this one <a>
     exists for it, so the link text stays the artist's name. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* The information box, occupying the lower half of the image. */
  .card__reveal {
    align-self: end;
    block-size: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    background: var(--scrim-strong);
    color: var(--on-scrim);
    /* Let clicks through to the stretched link, except on real links. */
    pointer-events: none;
  }

  .card__reveal :global(a) {
    pointer-events: auto;
    position: relative;
    z-index: 3;
  }

  .card__tagline {
    margin: 0;
    max-width: 40ch;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .card__genres {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--on-scrim-muted);
  }

  .card__manager {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--on-scrim-muted);
  }

  .card__manager-role {
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /*
   * Hover is an enhancement, never the only route to the information.
   * Where there is no fine pointer — touch, most tablets — the box is simply
   * visible, so tapping is never required to read it.
   */
  @media (hover: hover) and (pointer: fine) {
    .card__reveal {
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity var(--duration) var(--ease),
        transform var(--duration) var(--ease);
    }

    .card:hover .card__reveal,
    .card:focus-within .card__reveal {
      opacity: 1;
      transform: none;
    }

    .card:hover .card__media :global(img),
    .card:focus-within .card__media :global(img) {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__reveal {
      opacity: 1 !important;
      transform: none !important;
    }

    .card__media :global(img) {
      transform: none !important;
    }
  }
</style>
