        are not built yet.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--space-xl);
  }

  .about h1 {
    font-size: var(--text-2xl);
  }

  .about__body {
    margin-block-start: var(--space-lg);
  }

  .about__lead {
    font-size: var(--text-lg);
