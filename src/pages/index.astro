---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtistCard from '../components/ArtistCard.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';

const artists = (await getCollection('artists'))
  .filter((artist) => artist.data.status !== 'archived')
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));

/*
 * `featured` drives the plate at the top of the roster. Every featured artist
 * gets a turn there, cycling automatically; the rest fill the grid beneath.
 * If nothing is marked featured the first artist by order leads alone, so the
 * page always opens on a photograph rather than on a paragraph.
 */
const featured = artists.filter((artist) => artist.data.featured);
const lead = featured.length > 0 ? featured : artists.slice(0, 1);
const leadIds = new Set(lead.map((artist) => artist.id));
const rest = artists.filter((artist) => !leadIds.has(artist.id));
---

<BaseLayout
  title="Elsewise"
  description="Elsewise is a future-forward management agency based in Amsterdam."
>
  <section class="masthead page">
    <p class="label masthead__eyebrow">Artist management — Amsterdam</p>
    <h1 class="masthead__title">A future-forward management agency in Amsterdam.</h1>
  </section>

  <section class="roster" aria-labelledby="roster-heading">
    <h2 id="roster-heading" class="visually-hidden">Roster</h2>

    {
      lead.length > 0 && (
        <div class="page roster__lead">
          <FeaturedCarousel artists={lead} />
        </div>
      )
    }

    {
      rest.length > 0 && (
        <div class="page roster__rest">
          <hr class="rule" data-reveal />
          <p class="label roster__label">Also on the roster</p>
          <div class="roster__grid" data-reveal-group>
            {rest.map((artist, index) => (
              <ArtistCard artist={artist} eager={index < 2} />
            ))}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .masthead {
    padding-block: var(--space-lg) var(--space-md);
  }

  /*
   * A masthead, not a hero headline. It stays type-led but yields the first
   * screen to the lead photograph — the page is meant to read as a photo book,
   * and a photo book opens on a plate rather than on a statement.
   */
  .masthead__title {
    font-size: var(--text-2xl);
    max-width: 20ch;
    margin-block-start: var(--space-xs);
  }

  /*
   * A short opening sequence on load: the eyebrow, then the line. Runs once,
   * ends visible, and is pure CSS so it never depends on JS having loaded.
   */
  @media (prefers-reduced-motion: no-preference) {
    .masthead__eyebrow,
    .masthead__title {
      animation: masthead-rise 760ms var(--ease) both;
    }

    .masthead__title {
      animation-delay: 110ms;
    }
  }

  @keyframes masthead-rise {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-shift));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .roster__rest {
    margin-block-start: var(--space-2xl);
  }

  .roster__label {
    margin-block-start: var(--space-md);
  }

  .roster__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-xl) var(--space-md);
    margin-block-start: var(--space-lg);
  }
</style>
