{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elsewise",

  // The adapter's own entrypoint. It serves prerendered files from the ASSETS
  // binding and only runs Astro's SSR handler for non-prerendered routes.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
